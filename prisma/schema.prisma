// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts  Alert[]
  bookmarks Bookmark[]
}

model AnalysisCache {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD
  type      String   // 'daily_brief' | 'fed_news' | 'war_news' | 'indicators' | 'signals' | 'calendar' | 'traders' | 'multi_tf_signals'
  payload   String   // JSON string
  createdAt DateTime @default(now())

  @@unique([date, type])
  @@index([date])
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  symbol    String   // e.g. XAU/USD, WTI/USD, DXY, US10Y
  condition String   // 'above' | 'below' | 'change_pct' | 'strong_signal'
  threshold String
  note      String?
  active    Boolean  @default(true)
  triggered Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

// History of triggered live alerts (server-side, system-generated)
model SignalHistory {
  id        String   @id @default(cuid())
  symbol    String   // XAU/USD, WTI/USD
  timeframe String   // 15m, 1h, daily
  direction String   // long, short, neutral
  strength  Int      // 0-100
  entry     String?
  takeProfit String?
  stopLoss  String?
  source    String   // 'technical' | 'news' | 'traders' | 'composite'
  reason    String?
  telegramSent    Boolean  @default(false)
  telegramSentAt  DateTime?
  createdAt DateTime @default(now())

  @@index([symbol, timeframe, createdAt])
  @@index([createdAt])
  @@index([telegramSent])
}

// Telegram subscribers (for cron-based auto-sending when user is offline)
model TelegramSubscriber {
  id           String   @id @default(cuid())
  botToken     String   // Encrypted in production; plaintext here for simplicity
  chatId       String
  label        String?  // Optional name (e.g., "Ahmad's iPhone")
  enabled      Boolean  @default(true)
  threshold    Int      @default(75)  // Minimum strength to send
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSentAt   DateTime?

  @@index([enabled, threshold])
}

// Backtest evaluations — track win/loss outcomes of past signals
model EvaluationLog {
  id           String   @id @default(cuid())
  signalId     String   // References SignalHistory.id
  outcome      String   // 'win' | 'loss' | 'open'
  currentPrice String   // Price at time of evaluation
  evaluatedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([signalId])
  @@index([outcome])
  @@index([evaluatedAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  title     String
  url       String?
  category  String   // 'news' | 'indicator' | 'signal' | 'trader'
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for local dev, libsql for Turso production (set DATABASE_URL env var)
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Cache for market data (15-min TTL enforced in code)
model AnalysisCache {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD-HH or YYYY-MM-DD
  type      String   // 'daily_brief' | 'indicators' | 'signals' | 'multi_tf_signals' | 'calendar' | 'traders'
  payload   String   // JSON string
  createdAt DateTime @default(now())

  @@unique([date, type])
  @@index([date])
}

// History of triggered live alerts (server-side, system-generated)
model SignalHistory {
  id              String    @id @default(cuid())
  symbol          String    // XAU/USD, WTI/USD
  timeframe       String    // 15m, 1h, daily
  direction       String    // long, short, neutral
  strength        Int       // 0-100
  entry           String?
  takeProfit      String?
  stopLoss        String?
  source          String    // 'technical' | 'news' | 'traders' | 'composite'
  reason          String?
  telegramSent    Boolean   @default(false)
  telegramSentAt  DateTime?
  createdAt       DateTime  @default(now())

  @@index([symbol, timeframe, createdAt])
  @@index([createdAt])
  @@index([telegramSent])
}

// Telegram subscribers — store bot token + chat ID for cron-based auto-sending
// (no user account required, simple subscribe/unsubscribe model)
model TelegramSubscriber {
  id           String    @id @default(cuid())
  botToken     String
  chatId       String
  label        String?   // Optional: device name like "Ahmad's iPhone"
  enabled      Boolean   @default(true)
  threshold    Int       @default(75)  // Min strength to send signal
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSentAt   DateTime?

  @@index([enabled, threshold])
}

// Backtest evaluations — track win/loss outcomes of past signals
model EvaluationLog {
  id           String   @id @default(cuid())
  signalId     String   // References SignalHistory.id
  outcome      String   // 'win' | 'loss' | 'open'
  currentPrice String
  evaluatedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([signalId])
  @@index([outcome])
  @@index([evaluatedAt])
}
